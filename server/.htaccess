# server/.htaccess
# Blocks web access to everything in /server/ (the .env file, submission
# logs with candidate details, cache files, lib/ code) except the three
# endpoints the website's JavaScript calls.
# Note: the local "php -S" test server ignores this file; HostGator applies it.

Options -Indexes

<IfModule mod_authz_core.c>
    Require all denied
    <FilesMatch "^(contact-submit|careers-submit|careers-jobs)\.php$">
        Require all granted
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
    <FilesMatch "^(contact-submit|careers-submit|careers-jobs)\.php$">
        Allow from all
    </FilesMatch>
</IfModule>
