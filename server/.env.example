# Copy this file to server/.env and fill in real values.
# server/.env is gitignored — never commit real credentials.
#
# See docs/EMAIL-SETUP.md for step-by-step SMTP setup instructions
# (Gmail App Password, etc.) and how this file is loaded.

# ------------------------------------------------------------------
# Recipients — comma-separated, no spaces required. Swap these to the
# official company addresses when you're ready to go live; nothing
# else needs to change.
# ------------------------------------------------------------------
CAREERS_RECIPIENTS=contact@globalsoftsystems.com,contact@gsspros.com
CONTACT_RECIPIENTS=contact@globalsoftsystems.com,contact@gsspros.com

# ------------------------------------------------------------------
# From-address shown on outgoing mail (does not need to be a real
# inbox; it's the "From" header, not a recipient).
# ------------------------------------------------------------------
MAIL_FROM=noreply@globalsoftsystems.com
MAIL_FROM_NAME=GSS Careers Portal
CONTACT_MAIL_FROM=noreply@globalsoftsystems.com
CONTACT_MAIL_FROM_NAME=GSS Let's Connect

# ------------------------------------------------------------------
# SMTP relay used to actually send mail. Required for local testing:
# `php -S` (this project's dev server) has no mail transport of its
# own, so leaving this disabled means forms will validate correctly
# but no email will be delivered. See docs/EMAIL-SETUP.md.
# ------------------------------------------------------------------
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=your.address@gmail.com
SMTP_PASSWORD=your-16-character-app-password

# Log submissions to server/careers-submissions.log / contact-submissions.log
LOG_SUBMISSIONS=true
