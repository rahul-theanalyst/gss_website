# Copy this file to server/.env and fill in real values.
# server/.env is gitignored — never commit real credentials.
#
# Only the Ceipal careers API is configured here. The forms' email
# needs no settings — see docs/EMAIL-SETUP.md.

# ------------------------------------------------------------------
# Ceipal careers API — required to fetch live job openings on
# html/career.html. From the Ceipal widget embed tag:
#   data-ceipal-api-key="..."          -> CEIPAL_API_KEY
#   data-ceipal-career-portal-id="..." -> CEIPAL_CP_ID
# See docs/CEIPAL-INTEGRATION.md.
# ------------------------------------------------------------------
CEIPAL_API_KEY=
CEIPAL_CP_ID=
